<!DOCTYPE html>
<html lang="ca">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edita Llibre</title>
    <link rel="stylesheet" href="/css/books.css">
</head>
<body>
    <main class="container">
        <h1>Editar Llibre: <%= book.title %></h1>

        <form class="card" action="/books/<%= book.id %>?_method=PUT" method="POST">
            <label for="title">Títol:</label>
            <input type="text" id="title" name="title" value="<%= book.title %>" required>

            <label for="author">Autor:</label>
            <input type="text" id="author" name="author" value="<%= book.author %>" required>

            <label for="price">Preu (€):</label>
            <input type="number" id="price" name="price" value="<%= book.price %>" step="0.01" min="0" required>

            <button type="submit">Desar Canvis</button>
            <a class="back-link" href="/books">Tornar al llistat</a>
        </form>
    </main>
</body>
</html>
